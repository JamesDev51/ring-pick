{
  "name": "ring-pick",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:assets": "node scripts/generate-assets-v2.mjs && node scripts/check-assets.mjs",
    "verify": "npm run lint && npm run test && npm run check:assets && npm run build",
    "generate:fallback": "node scripts/generate-fallback-assets.mjs",
    "predev": "npm run generate:assets",
    "prebuild": "npm run generate:assets",
    "pree2e": "npm run generate:assets",
    "generate:assets": "node scripts/generate-assets-v2.mjs"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "6.0.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
